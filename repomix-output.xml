    showToast(`Neural Scan: Grade ${data.letter_grade} (${data.safety_index}/100)`);
  } catch (e) {
    box.innerHTML = `<div style="color: var(--danger); font-size: 11px; padding: 6px;">Error running neural scan: ${escapeHtml(e.message)}</div>`;

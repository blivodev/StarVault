            top.pack(fill="x")

            ctk.CTkLabel(
                top,
                text=k.algorithm_name,
                font=get_font(9, "bold"),
                text_color=ACCENT_PURPLE if "SSH" in k.algorithm_name else ACCENT_PRIMARY,
                fg_color=BG_INPUT,
                corner_radius=4,
                padx=6,
                pady=1,
            ).pack(side="left", padx=(0, 8))


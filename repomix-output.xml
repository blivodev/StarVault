    assert retrieved_meta.tags == ["docker", "prod"]
    assert retrieved_meta.notes == "StarVault deployment config"

    # 3. Read & Decrypt BLOB
    decrypted_bytes = db.read_file_bytes(retrieved_meta.id, key)

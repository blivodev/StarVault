        assert b"services:" not in raw_blob
        assert b"starvault:latest" not in raw_blob

    # 5. Delete file
    db.delete_file(retrieved_meta.id)
    assert len(db.get_all_files(key)) == 0
    assert db.read_file_bytes(retrieved_meta.id, key) is None



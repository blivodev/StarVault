            fg_color=ACCENT_PRIMARY,
            hover_color=ACCENT_HOVER,
            text_color="#000000",
            command=generate_and_use_apikey,
        ).pack(side="right")

        # Row 4: Secret Key (for paired key formats like AWS or Client Secrets)
        row4 = ctk.CTkFrame(container, fg_color="transparent")

          <div>Anomalies: <strong>${data.anomalies_count}</strong></div>
          <div>High Risk: <strong>${data.high_risk_count}</strong></div>
          <div style="font-size: 9px; color: var(--text-muted);">${data.execution_time_ms}ms • Zero-Knowledge</div>
        </div>
      </div>
      ${vulnsHtml}
      ${recsHtml}

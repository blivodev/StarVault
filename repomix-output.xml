        ctk.CTkLabel(row4, text="Secret Key / Secondary Token (Optional, Encrypted)", font=get_font(12), text_color=TEXT_SECONDARY).pack(anchor="w")
        sec_row = ctk.CTkFrame(row4, fg_color="transparent")

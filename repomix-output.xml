        dest = filedialog.asksaveasfilename(
            title="Save Rendered Code",
            defaultextension=".png",
            filetypes=[("PNG Image", "*.png")],
        )
        if dest:
            self._generated_img.save(dest)

    def _scan_file_studio(self) -> None:

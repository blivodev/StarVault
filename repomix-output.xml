    box.innerHTML = `
      <div class="neural-score-row">
        <div class="neural-gauge-large">
          <span class="neural-gauge-num" style="color: ${gradeColor};">${data.safety_index}</span>
          <span class="neural-gauge-label">/ 100</span>
        </div>

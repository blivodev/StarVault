# =============================================================================
# Feature Extraction Engine
# =============================================================================

def extract_entry_features(
    entry: VaultEntry,
    reuse_map: Optional[Dict[str, int]] = None,
    now: Optional[datetime] = None,
) -> Tuple[List[float], List[str]]:
    """Transforms a decrypted VaultEntry into a 12-dimensional normalized feature vector.
    
    Zero-Knowledge Guarantee:
    Raw passwords and private keys are never stored or exposed; only statistical
    entropy, length, and non-sensitive structural properties are computed.
    """
    if now is None:
        now = datetime.now(timezone.utc)

    detected_anomalies: List[str] = []
    pwd = entry.password or entry.api_token or ""
    is_keypair = entry.entry_type == "keypair"

    # 1. Normalized Length [0.0 - 1.0]
    # Optimal >= 24 chars, min standard 12
    pwd_len = len(pwd)
    if is_keypair:
        length_norm = 1.0
    else:
        length_norm = min(1.0, pwd_len / 24.0)

    # 2. Normalized Shannon Entropy [0.0 - 1.0]
    # 70+ bits considered strong for passwords, 128+ bits for keys
    if is_keypair:
        entropy_norm = 1.0
    else:
        entropy_bits = _calculate_shannon_entropy(pwd)
        entropy_norm = min(1.0, entropy_bits / 75.0)

    # 3. Character Class Variety [0.0 - 1.0]
    variety_count = 0
    if any(c.islower() for c in pwd): variety_count += 1
    if any(c.isupper() for c in pwd): variety_count += 1
    if any(c.isdigit() for c in pwd): variety_count += 1
    if any(not c.isalnum() for c in pwd): variety_count += 1
    variety_score = variety_count / 4.0 if not is_keypair else 1.0

    # 4. Pattern Cleanliness [0.0 - 1.0] (1.0 = clean, 0.0 = high repetition/predictability)
    pattern_score = 1.0
    if not is_keypair and pwd:
        lower_pwd = pwd.lower()
        # Repetitions
        if re.search(r"(.)\1{2,}", pwd):
            pattern_score -= 0.35
            detected_anomalies.append("Repeated character patterns detected")
        # Common sequential numbers or keyboard walks
        if re.search(r"123|abc|qwerty|asdf|admin|password|letmein|welcome", lower_pwd):
            pattern_score -= 0.50
            detected_anomalies.append("Predictable dictionary or sequence pattern detected")
        # Date or year pattern (e.g. 1999, 2024, 2025)
        if re.search(r"(19|20)\d{2}", pwd):
            pattern_score -= 0.25
            detected_anomalies.append("Contains common calendar year pattern")
        pattern_score = max(0.0, pattern_score)

    # 5. Stale / Age Factor [0.0 - 1.0]
    # > 180 days = 0.6, > 365 days = 1.0
    age_days = 0
    if entry.updated_at or entry.created_at:
        try:
            ts_str = entry.updated_at or entry.created_at
            dt = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            age_days = max(0, (now - dt).days)
        except Exception:
            age_days = 0
    age_factor = min(1.0, age_days / 365.0)
    if age_days > 365:
        detected_anomalies.append(f"Credential has not been rotated in {age_days} days")

    # 6. Expiry Urgency [0.0 - 1.0]
    # 1.0 = expired, 0.8 = <=7 days, 0.4 = <=30 days, 0.0 = safe
    expiry_urgency = 0.0
    if entry.expires_at:
        try:
            exp_dt = datetime.fromisoformat(entry.expires_at.replace("Z", "+00:00"))
            if exp_dt.tzinfo is None:
                exp_dt = exp_dt.replace(tzinfo=timezone.utc)
            days_left = (exp_dt - now).days
            if days_left < 0:
                expiry_urgency = 1.0
                detected_anomalies.append(f"Expired {abs(days_left)} days ago ({entry.expires_at[:10]})")
            elif days_left <= 7:
                expiry_urgency = 0.85
                detected_anomalies.append(f"Expiring critically soon in {days_left} days")
            elif days_left <= 30:
                expiry_urgency = 0.45
                detected_anomalies.append(f"Expiring in {days_left} days")
        except Exception:
            pass

    # 7. Exposure Surface [0.0 - 1.0]
    # Servers & public APIs have higher attack surface than offline personal keys
    exposure_surface = 0.3
    if entry.entry_type == "server":
        exposure_surface = 0.65
        if entry.username in ("root", "admin", "administrator"):
            exposure_surface += 0.20
            detected_anomalies.append(f"Privileged '{entry.username}' account directly exposed")
        if entry.port in (22, 3389, 80, 443, 8080):
            exposure_surface += 0.10
    elif entry.entry_type == "service":
        exposure_surface = 0.50
        if entry.url and entry.url.startswith("http://"):
            exposure_surface += 0.25
            detected_anomalies.append("Plaintext HTTP protocol in service URI")
    elif entry.entry_type == "apikey":
        exposure_surface = 0.60
        if getattr(entry, "environment", "").lower() == "production":
            exposure_surface += 0.20
    exposure_surface = min(1.0, exposure_surface)

    # 8. MFA / TOTP Protection [0.0 - 1.0] (1.0 = protected)
    has_totp = bool(getattr(entry, "totp_secret", ""))
    mfa_score = 1.0 if has_totp else 0.0
    if not has_totp and entry.entry_type in ("server", "service"):
        detected_anomalies.append("No 2FA / TOTP authentication configured")

    # 9. Reuse Count Normalized [0.0 - 1.0]
    reuse_count = 0
    if reuse_map and pwd:
        reuse_count = reuse_map.get(pwd, 1) - 1
    reuse_score = min(1.0, reuse_count / 4.0)
    if reuse_count > 0:
        detected_anomalies.append(f"Password reused across {reuse_count + 1} distinct vault records")

    # 10. Multi-Group / Organization Breadth [0.0 - 1.0]
    groups = getattr(entry, "groups", []) or []
    services = getattr(entry, "services", []) or []
    real_groups = [g for g in groups if g and g not in ("General", "Uncategorized")]
    group_breadth = 0.0
    if real_groups and services:
        group_breadth = 1.0
    elif real_groups or services:
        group_breadth = 0.6
    elif entry.category and entry.category not in ("General", "Uncategorized"):
        group_breadth = 0.4
    else:
        group_breadth = 0.1
        detected_anomalies.append("Unorganized: missing group and service assignments")

    # 11. Metadata Completeness [0.0 - 1.0]
    meta_count = 0
    if entry.username: meta_count += 1
    if entry.notes: meta_count += 1
    if entry.tags: meta_count += 1
    if getattr(entry, "custom_fields", None): meta_count += 1
    metadata_completeness = min(1.0, meta_count / 3.0)

    # 12. Key Algorithm Strength [0.0 - 1.0]
    key_algorithm_strength = 0.8
    if is_keypair:
        ktype = (getattr(entry, "key_type", "") or "").lower()
        if "ed25519" in ktype or "curve25519" in ktype or "4096" in ktype or "gpg" in ktype:
            key_algorithm_strength = 1.0
        elif "2048" in ktype:
            key_algorithm_strength = 0.6
            detected_anomalies.append("RSA-2048 keypair; upgrade to Ed25519 or RSA-4096 recommended")
        elif "dsa" in ktype or "1024" in ktype:
            key_algorithm_strength = 0.2
            detected_anomalies.append("Deprecated weak key algorithm detected")

    feature_vec = [
        round(length_norm, 4),
        round(entropy_norm, 4),
        round(variety_score, 4),
        round(pattern_score, 4),
        round(age_factor, 4),
        round(expiry_urgency, 4),
        round(exposure_surface, 4),
        round(mfa_score, 4),
        round(reuse_score, 4),
        round(group_breadth, 4),
        round(metadata_completeness, 4),
        round(key_algorithm_strength, 4),
    ]

    return feature_vec, detected_anomalies


# =============================================================================
# Neural Network Inference Engine
# =============================================================================

class VaultSecurityNeuralNet:
    """Zero-knowledge feed-forward neural network for cryptographic vault health classification."""

    def __init__(self) -> None:
        self.w1 = W1
        self.b1 = B1
        self.w2 = W2
        self.b2 = B2
        self.w_risk = W_RISK
        self.b_risk = B_RISK
        self.w_anom = W_ANOMALY
        self.b_anom = B_ANOMALY
        self.w_class = W_CLASS
        self.b_class = B_CLASS
        self.classes = CLASSES

    def extract_features(
        self,
        entry: VaultEntry,
        reuse_map: Optional[Dict[str, int]] = None,
        now: Optional[datetime] = None,
    ) -> List[float]:
        """Extracts 12-dimensional normalized feature vector for a vault entry."""
        vec, _ = extract_entry_features(entry, reuse_map=reuse_map, now=now)
        return vec

    def forward(self, features: List[float]) -> Tuple[float, float, str, Dict[str, float]]:
        """Executes forward pass through the two-layer perceptron.
        
        Returns:
            risk_prob: float (0.0 to 1.0)
            anomaly_prob: float (0.0 to 1.0)
            predicted_class: str
            class_probabilities: Dict[str, float]
        """
        # Hidden Layer 1 (12 -> 16)
        h1 = []
        for i in range(16):
            z = _dot_product(features, self.w1[i]) + self.b1[i]
            h1.append(_leaky_relu(z))

        # Hidden Layer 2 (16 -> 8)
        h2 = []
        for j in range(8):
            z = _dot_product(h1, self.w2[j]) + self.b2[j]
            h2.append(_leaky_relu(z))

        # Output Head 1: Risk Probability
        z_risk = _dot_product(h2, self.w_risk) + self.b_risk
        risk_prob = _sigmoid(z_risk)

        # Output Head 2: Anomaly Probability
        z_anom = _dot_product(h2, self.w_anom) + self.b_anom
        anomaly_prob = _sigmoid(z_anom)

        # Output Head 3: Multi-class Softmax Classification
        logits = []
        for k in range(len(self.classes)):
            z_c = _dot_product(h2, self.w_class[k]) + self.b_class[k]
            logits.append(z_c)

        probs = _softmax(logits)
        class_prob_map = {cls_name: prob for cls_name, prob in zip(self.classes, probs)}
        predicted_class = self.classes[probs.index(max(probs))]

        return risk_prob, anomaly_prob, predicted_class, class_prob_map

    def evaluate_entry(
        self,
        entry: VaultEntry,
        reuse_map: Optional[Dict[str, int]] = None,
        now: Optional[datetime] = None,
    ) -> NeuralEntryAssessment:
        """Evaluates an individual entry through the neural network."""
        features, anomalies = extract_entry_features(entry, reuse_map=reuse_map, now=now)
        risk_prob, anomaly_prob, pred_class, class_probs = self.forward(features)

        # Scale to 0-100 integers
        risk_score = int(round(risk_prob * 100))
        anomaly_score = int(round(anomaly_prob * 100))
        safety_score = max(0, 100 - risk_score)

        # Generate intelligent actionable remediation
        recommendations: List[str] = []
        auto_fix: Optional[str] = None

        if pred_class == "CRITICAL_EXPIRING" or features[5] > 0.4:
            recommendations.append(f"Rotate or renew credential before expiration ({entry.expires_at[:10] if entry.expires_at else 'soon'})")
            auto_fix = "extend_expiry"
        elif pred_class == "REUSED_CREDENTIAL" or features[8] > 0.2:
            recommendations.append("Generate unique high-entropy password to eliminate blast-radius credential reuse")
            auto_fix = "generate_password"
        elif pred_class == "WEAK_ENTROPY" or features[0] < 0.5 or features[1] < 0.5:
            recommendations.append("Upgrade password to 24+ characters with mixed character sets (entropy >= 80 bits)")
            auto_fix = "generate_password"
        elif pred_class == "UNPROTECTED_EXPOSURE" or features[7] < 0.5:
            recommendations.append("Enable TOTP / MFA and restrict privileged access surfaces")
            auto_fix = "enable_totp"
        elif pred_class == "STALE_UNROTATED" or features[4] > 0.5:
            recommendations.append("Perform scheduled lifecycle credential rotation")
            auto_fix = "generate_password"

        # Multi-group & service recommendations
        rec_groups = list(getattr(entry, "groups", []))
        rec_services = list(getattr(entry, "services", []))
        if not rec_groups:
            rec_groups = [entry.category or "Infrastructure"]
        if not rec_services:
            rec_services = [entry.app_name or entry.title]

        return NeuralEntryAssessment(
            entry_id=entry.id,
            entry_title=entry.title,
            entry_type=entry.entry_type,
            risk_score=risk_score,
            anomaly_score=anomaly_score,
            safety_score=safety_score,
            predicted_class=pred_class,
            class_probabilities=class_probs,
            feature_vector=features,
            anomalies=anomalies,
            recommendations=recommendations,
            recommended_groups=rec_groups,
            recommended_services=rec_services,
            auto_fix_action=auto_fix,
        )

    def audit_vault(
        self,
        entries: List[VaultEntry],
    ) -> NeuralVaultAudit:
        """Audits the entire vault collection in-memory using the neural network."""
        start_time = datetime.now(timezone.utc)
        if not entries:
            return NeuralVaultAudit(
                safety_index=100,
                letter_grade="A+",
                total_entries_evaluated=0,
                mean_risk_score=0.0,
                high_risk_entries_count=0,
                anomalies_flagged_count=0,
                entry_assessments=[],
                class_distribution={c: 0 for c in self.classes},
                top_vulnerabilities=[],
                suggested_optimizations=["Vault is currently empty. Add credentials to begin continuous neural protection."],
                execution_time_ms=0.5,
            )

        # Build reuse map
        reuse_map: Dict[str, int] = {}
        for e in entries:
            pwd = e.password or e.api_token
            if pwd:
                reuse_map[pwd] = reuse_map.get(pwd, 0) + 1

        now = datetime.now(timezone.utc)
        assessments: List[NeuralEntryAssessment] = []
        class_dist: Dict[str, int] = {c: 0 for c in self.classes}
        anomalies_total = 0
        high_risk_count = 0

        for e in entries:
            assessment = self.evaluate_entry(e, reuse_map=reuse_map, now=now)
            assessments.append(assessment)
            class_dist[assessment.predicted_class] = class_dist.get(assessment.predicted_class, 0) + 1
            anomalies_total += len(assessment.anomalies)
            if assessment.risk_score >= 65:
                high_risk_count += 1

        # Sort assessments by risk (highest risk first)
        assessments.sort(key=lambda a: (a.risk_score, a.anomaly_score), reverse=True)

        mean_risk = sum(a.risk_score for a in assessments) / float(len(assessments))
        safety_index = max(0, min(100, int(round(100.0 - mean_risk))))

        # Calculate Letter Grade
        if safety_index >= 95:
            letter_grade = "A+"
        elif safety_index >= 85:
            letter_grade = "A"
        elif safety_index >= 75:
            letter_grade = "B"
        elif safety_index >= 65:
            letter_grade = "C"
        elif safety_index >= 50:
            letter_grade = "D"
        else:
            letter_grade = "F"

        # Top vulnerabilities
        top_vulns = []
        for a in assessments[:5]:
            if a.risk_score > 35:
                top_vulns.append({
                    "entry_id": a.entry_id,
                    "title": a.entry_title,
                    "type": a.entry_type,
                    "risk_score": a.risk_score,
                    "predicted_class": a.predicted_class,
                    "anomalies": a.anomalies,
                    "recommendations": a.recommendations,
                })

        # Global optimization suggestions
        opts = []
        if class_dist.get("REUSED_CREDENTIAL", 0) > 0:
            opts.append(f"Eliminate password reuse across {class_dist['REUSED_CREDENTIAL']} entries using the 1-click generator.")
        if class_dist.get("CRITICAL_EXPIRING", 0) > 0:
            opts.append(f"Renew {class_dist['CRITICAL_EXPIRING']} certificates or tokens with upcoming expiration dates.")
        if class_dist.get("WEAK_ENTROPY", 0) > 0:
            opts.append(f"Upgrade {class_dist['WEAK_ENTROPY']} weak credentials to 24+ character high-entropy keys.")
        if class_dist.get("UNPROTECTED_EXPOSURE", 0) > 0:
            opts.append(f"Attach TOTP 2FA to {class_dist['UNPROTECTED_EXPOSURE']} exposed services.")
        if not opts:
            opts.append("Vault security posture is hardened; all neural checks evaluated optimal.")

        end_time = datetime.now(timezone.utc)
        elapsed_ms = round((end_time - start_time).total_seconds() * 1000.0, 2)

        return NeuralVaultAudit(
            safety_index=safety_index,
            letter_grade=letter_grade,
            total_entries_evaluated=len(entries),

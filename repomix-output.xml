                if val:
                    if val.startswith("otpauth://"):
                        try:
                            parsed = parse_otpauth_uri(val)
                            title_entry.delete(0, "end")
                            title_entry.insert(0, parsed.get("issuer") or parsed.get("account"))
                            user_entry.delete(0, "end")
                            user_entry.insert(0, parsed.get("account"))

                ("Encrypted StarVault Packages (*.sve)", "*.sve;*.starvault"),
                ("ZIP Archives (*.zip)", "*.zip"),
                ("Spreadsheet & JSON (*.csv, *.json)", "*.csv;*.json"),
                ("All Files", "*.*"),
            ],
        )
        if not p:
            return

        self.selected_file_path = Path(p)
